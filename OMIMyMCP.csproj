<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OMIMyMCP</AssemblyName>
    <RootNamespace>OMIMyMCP</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>1.0.0</Version>
    <Authors>Explobot</Authors>
    <Product>OMIMyMCP</Product>
    <Description>Importa le quotazioni immobiliari OMI (fonte: Agenzia Entrate - OMI) in SQLite e le espone come server MCP.</Description>
    <Copyright>Copyright 2026 Explobot</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Explo-bot/OMIMyMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Explo-bot/OMIMyMCP</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
